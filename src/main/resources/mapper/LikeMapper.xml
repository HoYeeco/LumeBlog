<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hoico.dao.LikeDAO">
    
    <resultMap id="LikeResultMap" type="com.hoico.model.Like">
        <id property="id" column="id"/>
        <result property="articleId" column="article_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
        <!-- 关联映射 -->
        <association property="user" column="user_id" javaType="com.hoico.model.User">
            <id property="id" column="user_id"/>
            <result property="username" column="username"/>
            <result property="nickname" column="nickname"/>
        </association>
    </resultMap>
    
    <!-- 根据文章ID查询点赞列表 -->
    <select id="findByArticleId" parameterType="Integer" resultMap="LikeResultMap">
        SELECT l.*, u.username, u.nickname
        FROM `likes` l
        LEFT JOIN user u ON l.user_id = u.id
        WHERE l.article_id = #{articleId}
        ORDER BY l.create_time DESC
    </select>
    
    <!-- 根据用户ID查询点赞列表 -->
    <select id="findByUserId" parameterType="Integer" resultMap="LikeResultMap">
        SELECT l.*, u.username
        FROM `likes` l
        LEFT JOIN user u ON l.user_id = u.id
        WHERE l.user_id = #{userId}
        ORDER BY l.create_time DESC
    </select>
    
    <!-- 检查用户是否已点赞文章 -->
    <select id="findByArticleAndUser" resultType="com.hoico.model.Like">
        SELECT * FROM `likes` 
        WHERE article_id = #{articleId} AND user_id = #{userId}
    </select>
    
    <!-- 新增点赞 -->
    <insert id="insert" parameterType="com.hoico.model.Like" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `likes` (article_id, user_id, create_time)
        VALUES (#{articleId}, #{userId}, #{createTime})
    </insert>
    
    <!-- 删除点赞 -->
    <delete id="delete" parameterType="Integer">
        DELETE FROM `likes` WHERE id = #{id}
    </delete>
    
    <!-- 根据文章ID和用户ID删除点赞 -->
    <delete id="deleteByArticleAndUser">
        DELETE FROM `likes` WHERE article_id = #{articleId} AND user_id = #{userId}
    </delete>
    
    <!-- 获取文章的点赞数 -->
    <select id="countByArticleId" parameterType="Integer" resultType="Integer">
        SELECT COUNT(*) FROM `likes` WHERE article_id = #{articleId}
    </select>
</mapper>
